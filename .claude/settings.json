{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm check)",
      "Bash(pnpm test:unit)",
      "Bash(pnpm test:int)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm generate:types)",
      "Bash(pnpm generate:importmap)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(vercel --prod:*)",
      "mcp__neon__create_*",
      "mcp__neon__update_*",
      "mcp__neon__delete_*",
      "mcp__neon__reset_*",
      "mcp__neon__set_*",
      "mcp__neon__restore_*",
      "mcp__neon__complete_*",
      "mcp__neon__prepare_*",
      "mcp__neon__get_connection_string",
      "mcp__vercel__deploy_*",
      "mcp__vercel__create_*",
      "mcp__vercel__update_*",
      "mcp__vercel__edit_*",
      "mcp__vercel__delete_*",
      "mcp__vercel__buy_*",
      "mcp__vercel__request_*",
      "mcp__vercel__get_project_env",
      "mcp__vercel__filter_project_envs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/guard-shell.mjs\" --tool=claude"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/guard-mcp.mjs\" --tool=claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/format.mjs\" --tool=claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/stop-typecheck.mjs\" --tool=claude",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
