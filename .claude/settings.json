{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm check)",
      "Bash(pnpm test:unit)",
      "Bash(pnpm test:int)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm generate:types)",
      "Bash(pnpm generate:importmap)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(.env.development.local)",
      "Edit(.env.development.local)",
      "Write(.env.development.local)",
      "Read(.env.test.local)",
      "Edit(.env.test.local)",
      "Write(.env.test.local)"
    ],
    "deny": [
      "Read(**/.env.production*)",
      "Edit(**/.env.production*)",
      "Write(**/.env.production*)",
      "Read(**/.vercel/**)",
      "Edit(**/.vercel/**)",
      "Write(**/.vercel/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-pg-start.sh\" >>/tmp/cloud-setup.log 2>&1 || true",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/guard-shell.mjs\" --tool=claude"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/guard-mcp.mjs\" --tool=claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/format.mjs\" --tool=claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/stop-typecheck.mjs\" --tool=claude",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
