# Local: any Postgres 15+. Production: Neon *pooled* connection string (host contains "-pooler").
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app

# openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public URL of the site (used by Payload for absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:43127

# Login codes are emailed via Resend. Without a key (outside production) the code is
# printed to the dev server console instead.
# RESEND_API_KEY=
# Must be on a domain verified in Resend. onboarding@resend.dev only delivers to your own address.
# EMAIL_FROM_ADDRESS=login@yourdomain.com

# Local dev syncs the schema automatically (Payload push). Set to false for extra processes
# that share the dev database (Playwright sets this for its workers). Ignored in production.
# PAYLOAD_DB_PUSH=true

# Optional: Vercel Blob for media uploads. Without it, uploads go to ./media (local dev only).
# BLOB_READ_WRITE_TOKEN=
