# Local: Postgres 18 (same major as Neon). Production: Neon *pooled* connection string (host contains "-pooler").
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app
# Precedence: DATABASE_URI (set by hand) → DATABASE_URL (Neon's per-preview branch on Vercel) → POSTGRES_URL
# (shared, from the Neon integration). sslmode=require|prefer|verify-ca is upgraded to verify-full.
# The chosen variable, host and a host fingerprint are logged once at startup. `KEY=` counts as unset.
# DATABASE_URI=
# POSTGRES_URL=

# openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public URL of the site (used by Payload for absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login codes are emailed via Resend. Without a key (outside production) the code is
# printed to the dev server console instead.
# RESEND_API_KEY=
# Must be on a domain verified in Resend. onboarding@resend.dev only delivers to your own address.
# `login@yourdomain.com` or `Your App <login@yourdomain.com>` (the name defaults to the site name).
# Mail other than login codes is refused on Vercel previews and from @resend.dev (src/lib/mail-gate.ts).
# EMAIL_FROM_ADDRESS=login@yourdomain.com

# Local dev syncs the schema automatically (Payload push). Set to false for extra processes
# that share the dev database (Playwright sets this for its workers). Push only ever runs against a
# local database (localhost, 127.0.0.1, ::1, postgres, host.docker.internal) and never in production.
# PAYLOAD_DB_PUSH=true

# Outside Vercel, the dev server, Payload CLI, create-admin and backup:restore refuse a remote database.
# Human-only, per command, never in an env file: docs/runbooks/production-admin.md. pnpm seed has no override.
# ALLOW_REMOTE_DATABASE=1

# Optional: product analytics. none (default) = nothing is sent. vercel = Vercel Web Analytics
# (page views + server-side custom events; enable Web Analytics in the Vercel project first).
# Visitors sending Do Not Track or Global Privacy Control are never tracked.
# ANALYTICS_PROVIDER=none

# Optional: Sentry error monitoring. Unset = no SDK is loaded at all.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Defaults to VERCEL_ENV / NODE_ENV.
# SENTRY_ENVIRONMENT=
# Build-time only (Vercel project env), enables readable stack traces via source-map upload.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Optional: Vercel Blob for media uploads. Without it, uploads go to ./media (local dev only).
# BLOB_READ_WRITE_TOKEN=

# Cron routes (/api/cron/*): Vercel sends `Authorization: Bearer $CRON_SECRET`. Unset = every cron request is
# refused on Vercel (fail closed); locally they are open. openssl rand -hex 32. Set it for Production only.
# CRON_SECRET=

# Tooling only (not read by the app). Several checkouts on one machine: run
# `bash scripts/local-env.sh <suffix>` — it writes these into .env*.local for you.
# Dev server port; `pnpm dev` reads it from the shell, .env.development.local or .env. Default 3000.
# PORT=3000
# Playwright target port when it differs from PORT.
# E2E_PORT=
# Database for `pnpm test:int` (default postgresql://app:app@127.0.0.1:5432/app_test).
# TEST_DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app_test
# Host port of the docker-compose Postgres, when 5432 is taken.
# POSTGRES_HOST_PORT=5432
